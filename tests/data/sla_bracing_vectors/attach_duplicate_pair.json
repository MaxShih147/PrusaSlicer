{
  "id": "attach_duplicate_pair",
  "description": "Both pillars at the pair cap: the greedy pass refuses them, attach() braces them, and attaching them again, either way round, is a duplicate pair.",
  "cfg": {"safety_clearance":0.2,"min_shared_angle_deg":20,"pair_cap":3,"max_link_distance":10,"min_pillar_distance":1,"rescue_height":15,"bridge_slope_deg":45,"ground_z":0,"base_height":1,"base_radius":2,"connection_mode":"dynamic"},
  "pillars": [
    {"id":0,"endpoint":[0,0,0.0],"height":14,"r":0.5,"links":0,"pairs":3,"frozen":false},
    {"id":1,"endpoint":[6,0,0.0],"height":14,"r":0.5,"links":0,"pairs":3,"frozen":false}
  ],
  "bars": [],
  "attach": [[0,1],[1,0],[0,1]],
  "expect": {
    "accepted": [
      {"phase":"attach","pair":[0,1],"bars_built":4}
    ],
    "rejected": [
      {"phase":"greedy","pair":[0,1],"reason":"pair_cap"},
      {"phase":"attach","pair":[0,1],"reason":"duplicate_pair"},
      {"phase":"attach","pair":[0,1],"reason":"duplicate_pair"}
    ],
    "pillars_after": [
      {"id":0,"links":1,"pairs":4},
      {"id":1,"links":1,"pairs":4}
    ]
  }
}
